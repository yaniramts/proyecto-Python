"""
Módulo de Gestión de Citas Clínicas.
El programa va a permitir administrar la reserva de citas de los pacientes en una clínica.
"""

# 1. Estructura de almacenamiento principal (Diccionario vacío)
citas = {}

def menu():
    """Muestra el menú interactivo y mantiene el programa en ejecución."""
    while True:
        print("\n=== MENÚ DE LA CLÍNICA ===")
        print("1. Añadir cita")
        print("2. Buscar cita")
        print("3. Modificar cita")
        print("4. Eliminar cita")
        print("5. Mostrar todas")
        print("6. Salir")
        
        # Pedimos al usuario que elija una opción
        opcion = input("Elige una opción (1-6): ")
        
        if opcion == '1':
            insertar_elemento(citas)
        elif opcion == '2':
            buscar_elemento(citas)
        elif opcion == '3':
            modificar_elemento(citas)
        elif opcion == '4':
            eliminar_elemento(citas)
        elif opcion == '5':
            mostrar_todos(citas)
        elif opcion == '6':
            print("Has salido del programa. ¡Hasta pronto!")
            break  # Esto rompe el bucle while y cierra el programa
        else:
            print("Opción no válida.")


# Pedir datos para la cita 
def insertar_elemento(datos):
    """Pide los datos de una cita y los guarda tras validar el DNI."""
    id_cita = input("Introduce el DNI del paciente:")

    # comprobamos que el DNI no esté vacío
    if id_cita == "":
        print("Error: El DNI no puede estar vacío")
        return
    
    nombre = input("Introduce el nombre del paciente:")
    hora = input("Introduce la hora de la cita (ej: 10:30):")

    # guardar los datos en el diccionario (citas={})
    datos[id_cita] = {"nombre": nombre, "hora": hora}
    print("Cita añadida con éxito!")


def buscar_elemento(datos):
    """Busca una cita por el DNI del paciente y muestra sus datos."""
    dni_buscar = input("Introduce el DNI del paciente a buscar:")
    
    try:
        # Intentamos buscar el DNI en el diccionario
        cita = datos[dni_buscar]
        print(f"Cita encontrada -> Paciente: {cita['nombre']} | Hora: {cita['hora']}")
    except KeyError:
        print("Error: No existe ninguna cita con ese DNI.")


def modificar_elemento(datos):
    """Permite modificar la hora de una cita."""
    buscar_dni = input("Introduce el DNi del paciente que quiere modificar su cita:")

    try:
        # Intentamos modificar la hora
        cita = datos[buscar_dni]

        print(f"La cita de {cita['nombre']} es a las {cita['hora']}")
        nueva_hora = input("Introduce la hora a la que quieres modificar la cita:")

        datos[buscar_dni]['hora'] = nueva_hora
        print('¡Cita modificada con éxito!')

    except KeyError:
        print("Error: No existe ninguna cita con ese DNI.")


def eliminar_elemento(datos):
    """Permite eliminar una cita proporcionando el DNI del paciente."""
    dni_eliminar = input("Introduzca el DNI de la cita que desea eliminar:")
    try:
        del datos[dni_eliminar]
        print("¡Cita eliminada con éxito!")
    except KeyError:
        # Si el DNI no está guardado, no se elimina la cita
        print("ERROR: No existe ninguna cita con ese DNI.")


def mostrar_todos(datos):
    """Lo usaremos para mostrar las citas guardadas."""
    if len(datos) == 0:
        print("\nActualmente no hay citas guardadas")
        return
    else:   
        print("\nESTA ES LA LISTA ACTUAL DE CITAS:")
        print(datos)


# Llamamos al menú para que arranque al ejecutar el archivo
menu() 
